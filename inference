# =================== Conda environment =================== #

source /home/ubuntu/miniconda3/etc/profile.d/conda.sh
conda activate lerobot


# =================== RTC control (local real-time chunking) =================== #
# 本机后台线程持续推理并合并 action chunk，适合推理较慢的 SmolVLA。

lerobot-rollout \
--strategy.type=base \
--policy.path=/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/smolvla_pick_place/checkpoints/160000/pretrained_model \
--policy.vlm_model_name=/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/SmolVLM2-500M-Video-Instruct \
--robot.type=realman_pika \
--robot.calibration_dir=/home/ubuntu/Documents/CodeField/zehao/lerobot/.cache/realman_pika_calibration \
--robot.robot_ip=192.168.1.18 \
--robot.gripper_serial_port=/dev/ttyUSB60 \
--robot.cameras='{rgb: {type: intelrealsense, serial_number_or_name: "419122270755", width: 640, height: 480, fps: 30}, fisheye: {type: opencv, index_or_path: "/dev/video60", width: 640, height: 480, fps: 30}}' \
--inference.type=rtc \
--inference.rtc.execution_horizon=5 \
--inference.action_interval_s=0.13 \
--inference.action_replan_interval=1 \
--inference.gripper_lookahead_steps=2 \
--fps=30 \
--robot.table_collision_enabled=true \
--robot.table_height_m=0.23 \
--robot.robot_action_latency=0.03 \
--robot.gripper_action_latency=0.0 \
--robot.max_pos_speed=0.01 \
--robot.max_rot_speed=0.10 \
--confirm_each_action=false \
--task="pick the pink block and place it onto the black pad" \
--duration=300 \
--log_controller_actions=true \
--record_cameras=true \
--record_camera_output_dir=/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/rollout_camera_recordings/rtc \
--record_camera_fps=30


