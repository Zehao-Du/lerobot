# =================== Async control (separate policy server/client) =================== #
# 这是 LeRobot 独立的远程异步推理，不是 --inference.type=async。
# 当前 lerobot conda 环境尚未安装 grpcio；首次使用前在仓库根目录执行一次：
# python -m pip install -e '.[async]'
# 此 checkpoint 仍保存着训练机器的 /inspire/... VLM 路径。运行 Async 前需要把以下两处改成本机路径：
#   config.json 中的 vlm_model_name
#   policy_preprocessor.json 中的 tokenizer_name
# 本机路径：/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/SmolVLM2-500M-Video-Instruct
# Async 不经过 lerobot-rollout，因此没有 --duration、RTC 参数或 rollout 相机录像参数；Ctrl-C 停止。

# Terminal 1: policy server
source /home/ubuntu/miniconda3/etc/profile.d/conda.sh
conda activate lerobot
cd /home/ubuntu/Documents/CodeField/zehao/lerobot
python -m lerobot.async_inference.policy_server \
--host=127.0.0.1 \
--port=8080 \
--fps=30 \
--inference_latency=0.13 \
--obs_queue_timeout=1.0

