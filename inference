# =========================== Human in loop inference =========================== #
# 输入打印出的 action 序号（0, 1, 2, ...）执行对应 action；同一序号可以重复执行。
# 同一个 chunk 的所有 action 共用推理开始时的 TCP pose，不会随 action 执行而改变。
# 运行中输入 offset 0.005 可随时修改 gripper width offset（单位：米）。
# 输入 next 使用机器人最新观测开始下一次推理；输入 quit 退出。

lerobot-rollout \
--strategy.type=base \
--policy.path=/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/smolvla_pick_place/checkpoints/160000/pretrained_model \
--policy.vlm_model_name=/home/ubuntu/Documents/CodeField/zehao/lerobot/outputs/SmolVLM2-500M-Video-Instruct \
--robot.type=realman_pika \
--robot.calibration_dir=/home/ubuntu/Documents/CodeField/zehao/lerobot/.cache/realman_pika_calibration \
--robot.robot_ip=192.168.1.18 \
--robot.gripper_serial_port=/dev/ttyUSB60 \
--robot.cameras='{rgb: {type: intelrealsense, serial_number_or_name: "419122270755", width: 640, height: 480, fps: 30}, fisheye: {type: opencv,
index_or_path: "/dev/video60", width: 640, height: 480, fps: 30}}' \
--inference.type=human_in_loop \
--inference.gripper_width_offset=0.0 \
--fps=30 \
--robot.table_collision_enabled=false \
--robot.table_height_m=0.23 \
--robot.max_relative_pos=inf \
--robot.robot_action_latency=0.03 \
--robot.gripper_action_latency=0.0 \
